# Šipkoviště.cz – proměnné pro lokální vývoj a Vercel
# Zkopíruj do .env.local a vyplň hodnoty z Supabase Dashboard
#
# BEZPEČNOST:
# - NIKDY necommituj .env.local ani skutečné klíče
# - NEXT_PUBLIC_* jsou viditelné v prohlížeči – pouze URL a anon key
# - SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY = pouze na serveru, nikdy NEXT_PUBLIC

# Supabase (povinné)
NEXT_PUBLIC_SUPABASE_URL=https://tvuj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tvuj-anon-public-key

# Pro funkce jako mazání účtu, e-mailové notifikace (server-only, nepoužívat v klientu)
SUPABASE_SERVICE_ROLE_KEY=tvuj-service-role-key

# Resend – e-mailové notifikace (z Resend dashboard)
RESEND_API_KEY=re_xxxx
# DŮLEŽITÉ: S onboarding@resend.dev lze posílat JEN na e-mail tvého Resend účtu.
# Pro odesílání na libovolné adresy ověř doménu na resend.com/domains a nastav:
RESEND_FROM=Šipkoviště <noreply@sipkoviste.cz>

# Produkce: kanonická URL (sitemap, metadata, redirecty)
# Na Vercel lze nechat prázdné – použije se VERCEL_URL
NEXT_PUBLIC_SITE_URL=https://sipkoviste.cz

# Volitelné: redirect po přihlášení v dev
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# Facebook App ID (pro fb:app_id – odstraní varování v Sharing Debuggeru)
# Vytvoř na developers.facebook.com → Moje aplikace → Přidat aplikaci
# NEXT_PUBLIC_FB_APP_ID=123456789012345

# Redis / Vercel KV – distribuovaný rate limiting (produkce)
# Bez těchto proměnných se použije in-memory fallback (nefunguje při horizontálním škálování)
# Vercel: přidej Redis z Marketplace (KV_REST_API_URL, KV_REST_API_TOKEN)
# Upstash: UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=AXXXxxx
